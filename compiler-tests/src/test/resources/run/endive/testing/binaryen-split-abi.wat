;; Adapted from Binaryen function-splitting-routed-globals.wast.
(module
  (memory 1)
  (func $mailbox (param $x i32) (result i32)
    (local $a i32)
    (local $b i32)
    (local $c i32)
    (block $exit
      (if (local.get $x)
        (then
          ;; Recursive re-entry reaches the same generated helper. The outer
          ;; invocation keeps its state in locals and writes the mailbox only
          ;; after the inner call and its caller-side restores have completed.
          (local.set $a
            (if (result i32)
              (i32.gt_u (local.get $x) (i32.const 1))
              (then
                (call $mailbox (i32.sub (local.get $x) (i32.const 1)))
              )
              (else
                (i32.add (local.get $x) (i32.const 1))
              )
            )
          )
          (local.set $b (i32.add (local.get $x) (i32.const 2)))
          (local.set $c (i32.add (local.get $x) (i32.const 3)))
          (i32.store (i32.const 0)
            (i32.add (i32.const 1)
            (i32.add (i32.const 2)
            (i32.add (i32.const 3)
            (i32.add (i32.const 4)
            (i32.add (i32.const 5)
            (i32.add (i32.const 6)
            (i32.add (i32.const 7)
            (i32.add (i32.const 8)
            (i32.add (i32.const 9)
            (i32.add (i32.const 10)
            (i32.add (i32.const 11)
            (i32.add (i32.const 12)
            (i32.add (i32.const 13)
            (i32.add (i32.const 14)
            (i32.add (i32.const 15)
            (i32.add (i32.const 16)
            (i32.add (local.get $a)
              (i32.add (local.get $b) (local.get $c))))))))))))))))))))
          (br $exit)
        )
      )
      (local.set $a (i32.const 40))
      (local.set $b (i32.const 1))
      (local.set $c (i32.const 1))
    )
    (i32.add (local.get $a)
      (i32.add (local.get $b) (local.get $c)))
  )
  (func $mailbox2 (param $x i32) (result i32)
    (local $a i32)
    (local $b i32)
    (local $c i32)
    (block $exit
      (if (local.get $x)
        (then
          (local.set $a (i32.add (local.get $x) (i32.const 1)))
          (local.set $b (i32.add (local.get $x) (i32.const 2)))
          (local.set $c (i32.add (local.get $x) (i32.const 3)))
          ;; Keep the second independent boundary above the same size target as
          ;; $mailbox without adding another call or observable effect.
          (drop (i32.add (local.get $x) (i32.const 90)))
          (drop (i32.add (local.get $x) (i32.const 91)))
          (drop (i32.add (local.get $x) (i32.const 92)))
          (drop (i32.add (local.get $x) (i32.const 93)))
          (i32.store (i32.const 4)
            (i32.add (i32.const 1)
            (i32.add (i32.const 2)
            (i32.add (i32.const 3)
            (i32.add (i32.const 4)
            (i32.add (i32.const 5)
            (i32.add (i32.const 6)
            (i32.add (i32.const 7)
            (i32.add (i32.const 8)
            (i32.add (i32.const 9)
            (i32.add (i32.const 10)
            (i32.add (i32.const 11)
            (i32.add (i32.const 12)
            (i32.add (i32.const 13)
            (i32.add (i32.const 14)
            (i32.add (i32.const 15)
            (i32.add (i32.const 16)
            (i32.add (local.get $a)
              (i32.add (local.get $b) (local.get $c))))))))))))))))))))
          (br $exit)
        )
      )
      (local.set $a (i32.const 40))
      (local.set $b (i32.const 1))
      (local.set $c (i32.const 1))
    )
    (i32.add (local.get $a)
      (i32.add (local.get $b) (local.get $c)))
  )
  (func $_start
    (if
      (i32.ne (call $mailbox (i32.const 3)) (i32.const 29))
      (then unreachable)
    )
    (if
      (i32.ne (call $mailbox (i32.const 0)) (i32.const 42))
      (then unreachable)
    )
    (if
      (i32.ne (call $mailbox2 (i32.const 3)) (i32.const 15))
      (then unreachable)
    )
    (if
      (i32.ne (call $mailbox2 (i32.const 0)) (i32.const 42))
      (then unreachable)
    )
  )
  (export "_start" (func $_start))
)
